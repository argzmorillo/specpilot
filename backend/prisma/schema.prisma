generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analysis {
  id String @id @default(cuid())

  keycloakUserId String

  inputText      String
  summary        String
  userStories    Json
  technicalTasks Json
  risks          Json
  questions      Json

  requestDurationMs Int?
  completionTokens  Int?
  promptTokens      Int?
  totalTokens       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model    String?
  metadata Json?

  @@index([keycloakUserId])
  @@index([keycloakUserId, createdAt])
  @@map("analyses")
} 

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestedApplication {
  SPECPILOT
}

model AccessRequest {
  id String @id @default(cuid())

  keycloakUserId String
  email          String
  fullName       String?

  approvedRole   String?

  requestedApplication RequestedApplication
  status               AccessRequestStatus @default(PENDING)

  message    String?
  adminNotes String?

  reviewedAt DateTime?
  reviewedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keycloakUserId, requestedApplication])
  @@index([email])
  @@index([status])
  @@map("access_requests")
}
