# Application
NODE_ENV=development
PORT=3000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Database
DATABASE_URL="postgresql://specpilot:specpilot@localhost:5432/specpilot?schema=public"

# Keycloak / OIDC
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/ecosystem
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/ecosystem/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=specpilot-api

# Keycloak Admin API
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=ecosystem
KEYCLOAK_ADMIN_CLIENT_ID=specpilot-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200